{% import "macros/images.html.jinja" as image_macros with context -%}
{% import "macros/old_texture_macros.html.jinja" as texture_macros with context -%}


<details class="details-collapsible flay-recipe-details">
  {% block collapse %}
    <summary class="collapse-details">
      <span class="collapse-recipe-show">{{ _('hexdoc.recipe.show') }}</span>
      <span class="collapse-recipe-hide">{{ _('hexdoc.recipe.hide') }}</span>
    </summary>
  {% endblock collapse %}

  <div>
    {% block title %}<h5>{{ recipe.result.Name.name }}</h5>{% endblock %}

    <div class="flay-recipe">
      {% block background %}
        <img
          class="flay-recipe-background"
          alt="Flay Mind Recipe GUI"
          src="{% block background_image %}{{
            ('fishcasting:textures/gui/hexdoc/brainsweep_void.png'|hexdoc_texture_image).url
            | replace('v/0.2.16+1.21.1/1.0/renders/', '../renders/')
          }}{% endblock %}"
        >
      {% endblock background %}

      {% block brainsweepee %}
        {% with brainsweepee=recipe.entity_in %}
          {% include recipe.entity_in.template~".html.jinja" %}
        {% endwith %}
      {% endblock brainsweepee %}

      {% block ingredient %}
        <div class="flay-recipe-block-ingredient">
          {{ image_macros.item(recipe.block_in.block) }}
        </div>
      {% endblock ingredient %}

      {% block cost %}
        <div class="flay-recipe-cost texture item-texture multi-textures cycle-textures">
          {% for item in recipe.cost_items %}
            <div class="texture item-texture {{ 'multi-texture-active' if loop.first }}">
              {{ image_macros.item(item|hexdoc_item_image, count=item.count, is_first=true) }}
            </div>
          {% endfor %}
        </div>
      {% endblock cost %}

      {% block result %}
        <div class="flay-recipe-result">
          {{ image_macros.item(recipe.result.Name) }}
        </div>
      {% endblock result %}
    </div>
  </div>
</details>